# SDD 控制器工作区（台账、简报、审阅包）
.superpowers/

# 手工验证时的临时落脚处：fixture、探针脚本、装来用一次的库
.scratch/

# 代码索引工具的本地缓存
.codegraph/

# 构建产物
recorder.exe
/dist/
node_modules/

# go-winres 生成的 Windows 资源（图标 + 版本信息）：由 make / release.yml 按
# 当前 tag 现场生成，版本必须跟着 tag 走，所以不入库。
rsrc_windows_*.syso

# 密钥与凭据——绝不允许入库
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials.json
*credentials*.json
!docs/**/credentials*.md

# 本地数据库与运行时数据
*.db
*.db-journal
*.sqlite
*.sqlite3
*.local.json

# 编辑器与系统
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
